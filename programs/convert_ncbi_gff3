#!/usr/bin/env python
"""Developed against Rnor6 RefSeq.

Also used for vertebrate RefSeq GFF3. Symbolic
transcript IDs such as NCBI tRNA names (trnaa-agc, trnaa-agc-2) are rewritten
to GeneID-based IDs so transMapPslToGenePred's version stripping (treats
trailing -N / .N as versions) cannot collide them.
"""
import argparse
import re
from BCBio import GFF
from collections import Counter, OrderedDict


# RefSeq / GenBank accessions — keep as transcript_id (version strip is OK).
ACCESSION_RE = re.compile(r"^[A-Z]{1,3}_\d+(?:\.\d+)?$")
TYPE_PREFIXES = {"rna", "exon", "cds", "gene", "id"}


def parse_args():
    parser = argparse.ArgumentParser()
    parser.add_argument('input_gff3', help='RefSeq GFF3 file')
    parser.add_argument('output_gff3', help='Output GFF3')
    return parser.parse_args()


def get_unique_id(i, c, update_id=True):
    """Uniquify accession-style IDs with .N (intentional version form)."""
    if i not in c:
        c[i] = 0
        return i
    if update_id is True:
        c[i] += 1
    if c[i] > 0:
        return f"{i}.{c[i]}"
    return i


def allocate_symbolic_tx_id(base, c, update_id=True):
    """Uniquify non-accession IDs with _vN (NOT .N / -N).

    transMapPslToGenePred strips trailing .N / -N as versions and then looks up
    the base name, so trnaa-agc-2 collides with trnaa-agc. Underscore suffixes
    do not trigger that path.
    """
    if base not in c:
        c[base] = 1
        return base
    if update_id:
        c[base] += 1
    n = c[base]
    return base if n == 1 else f"{base}_v{n}"


def normalize_raw_tx_id(raw):
    """Strip NCBI type prefixes (rna-, exon-, ...) but keep accessions intact."""
    if ACCESSION_RE.match(raw):
        return raw
    if '-' in raw:
        prefix, rest = raw.split('-', 1)
        if prefix.lower() in TYPE_PREFIXES:
            return rest
    return raw


def add_tags_to_feature(feature, noid_count, tx_counts, gene_counts, parent_feature=None):
    if feature.type not in ['ncRNA', 'tRNA', 'rRNA', 'pseudogene', 'lnc_RNA',
                   'rRNA', 'mRNA', 'snRNA', 'snoRNA', 'scRNA', 'antisense_RNA', 'guide_RNA',
                   'C_gene_segment', 'J_gene_segment', 'V_gene_segment',
                   'primary_transcript', 'miRNA', 'transcript', 'CDS', 'exon', 'gene',
                   'SRP_RNA', 'telomerase_RNA']:
        return
    if 'dbxref' in feature.qualifiers:
        xref = feature.qualifiers['dbxref']
    elif 'Dbxref' in feature.qualifiers:
        xref = feature.qualifiers['Dbxref']
    else:  # hacky fix
        xref = ['GeneID:NoID-{}'.format(noid_count)]
        noid_count += 1
    ids = dict([x.split(':', 1) for x in xref])
    if feature.type == 'gene':
        assert feature == parent_feature
        feature.qualifiers['gene_id'] = [get_unique_id(ids['GeneID'], gene_counts)]
        feature.qualifiers['gene_name'] = feature.qualifiers.get('gene', feature.qualifiers.get('product', feature.qualifiers['gene_id']))
        # Set gene_biotype if not present (some genes might be missing this field)
        if 'gene_biotype' not in feature.qualifiers:
            feature.qualifiers['gene_biotype'] = ['gene']
        return
    feature.qualifiers['gene_id'] = [get_unique_id(ids['GeneID'], gene_counts, update_id=False)]
    feature.qualifiers['gene_name'] = feature.qualifiers.get('gene', feature.qualifiers.get('product', feature.qualifiers['gene_id']))
    gene_id = feature.qualifiers['gene_id'][0]

    raw = feature.qualifiers.get('transcript_id', feature.qualifiers.get('ID', feature.qualifiers.get('Parent')))[0]
    tx_id = normalize_raw_tx_id(raw)
    is_transcript = feature.type not in ['CDS', 'exon']

    if ACCESSION_RE.match(tx_id):
        # Keep RefSeq accessions; .N uniquifier / version strip is fine here.
        tx_id = get_unique_id(tx_id, tx_counts, update_id=is_transcript)
    else:
        # Symbolic names (tRNA, etc.): GeneID-based to avoid version-strip collisions.
        tx_id = allocate_symbolic_tx_id(f"gid{gene_id}", tx_counts, update_id=is_transcript)

    feature.qualifiers['transcript_id'] = [tx_id]
    # Keep a human-readable name when NCBI provided one.
    pretty = feature.qualifiers.get('Name', feature.qualifiers.get('gene', [tx_id]))
    feature.qualifiers['transcript_name'] = pretty if pretty else [tx_id]
    # figure out gene biotype
    if 'gene_biotype' in parent_feature.qualifiers:
        gene_biotype = parent_feature.qualifiers['gene_biotype']
    else:
        gene_biotype = [feature.type]

    # figure out transcript biotype
    if feature.type == 'primary_transcript':
        transcript_biotype = ['miRNA']
    elif 'segment' in feature.type:
        transcript_biotype = [feature.type]
        feature.type = 'ncRNA'
    elif feature.type == 'lnc_RNA':
        feature.type = 'lncRNA'
        transcript_biotype = [feature.type]
    else:
        transcript_biotype = gene_biotype
    feature.qualifiers['gene_biotype'] = gene_biotype
    feature.qualifiers['transcript_biotype'] = transcript_biotype


def construct_new_qualifiers(feature):
    new_qualifiers = OrderedDict()
    for key, val in feature.qualifiers.items():
        # no upper case keys unless it is ID or Parent or Name
        if key not in ['ID', 'Parent', 'Name']:
            key = key.lower()
        # collapse to a single item
        # replace all semicolons
        if len(val) > 1:
            val = [' '.join([x.replace(';', '%3B').replace('=', '%3D') for x in val])]
        new_qualifiers[key] = val
    # clean up and make parseable
    for key, val in new_qualifiers.items():
        if sum(len(x) for x in val) == 0:
            new_qualifiers[key] = 'True'
    return new_qualifiers


def feature_traversal(feature):
    yield feature
    for sub_feature in feature.sub_features:
        yield from feature_traversal(sub_feature)


TRANSCRIPT_FEATURE_TYPES = {
    'ncRNA', 'tRNA', 'rRNA', 'pseudogene', 'lncRNA', 'lnc_RNA', 'mRNA',
    'snRNA', 'snoRNA', 'scRNA', 'antisense_RNA', 'guide_RNA',
    'C_gene_segment', 'J_gene_segment', 'V_gene_segment',
    'primary_transcript', 'miRNA', 'transcript',
    'SRP_RNA', 'telomerase_RNA',
}


def gene_has_transcript_child(gene_feature):
    return any(sf.type in TRANSCRIPT_FEATURE_TYPES for sf in gene_feature.sub_features)


def add_gene_level_transcript_tags(gene_feature, tx_counts):
    """gff3ToGenePred treats gene-only models (exon/CDS under gene) as transcripts."""
    if 'transcript_id' in gene_feature.qualifiers:
        return
    gene_id = gene_feature.qualifiers['gene_id'][0]
    tx_id = allocate_symbolic_tx_id(f"gid{gene_id}", tx_counts, update_id=False)
    biotype = gene_feature.qualifiers.get('gene_biotype', ['pseudogene'])
    gene_feature.qualifiers['transcript_id'] = [tx_id]
    gene_feature.qualifiers['transcript_name'] = [tx_id]
    gene_feature.qualifiers['transcript_biotype'] = biotype


if __name__ == '__main__':
    args = parse_args()
    noid_count = 1
    tx_counts = Counter()
    gene_counts = Counter()
    records = list(GFF.parse(args.input_gff3))
    for seqrecord in records:
        for parent_feature in seqrecord.features:
            for feature in feature_traversal(parent_feature):
                add_tags_to_feature(feature, noid_count, tx_counts, gene_counts, parent_feature)
                if parent_feature.type == 'gene' and not gene_has_transcript_child(parent_feature):
                    if feature.type == 'CDS':
                        # convert gene into fake transcript; we lack a parent
                        parent_feature.qualifiers['transcript_biotype'] = ['protein_coding']
                        parent_feature.qualifiers['transcript_id'] = feature.qualifiers['transcript_id']
                        parent_feature.qualifiers['transcript_name'] = feature.qualifiers['transcript_name']
                    elif feature.type == 'exon':
                        add_gene_level_transcript_tags(parent_feature, tx_counts)
                new_qualifiers = construct_new_qualifiers(feature)
                feature.qualifiers = new_qualifiers
            if parent_feature.type == 'gene' and not gene_has_transcript_child(parent_feature):
                add_gene_level_transcript_tags(parent_feature, tx_counts)

    with open(args.output_gff3, 'w') as fh:
        GFF.write(records, fh)
